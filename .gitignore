# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs and temp
*.log
*.tmp
*.bak

# Node / npm (in case future tooling is added)
node_modules/
package-lock.json
npm-debug.log*

# Python (in case future tooling is added)
__pycache__/
*.pyc
.venv/
venv/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# Backend secrets — session cookies, local-only data
backend/.env
backend/.env.local
backend/.env.production
backend/.sessions/
backend/.sessions/**
backend/data/local/      # 私有完整資料（僅本機）
backend/data/local/**
data/local/             # 私有資料快照
data/local/**
# Note: backend/.env.example is NOT ignored (it should be committed as template)

# Build outputs (in case bundler is added later)
dist/
build/