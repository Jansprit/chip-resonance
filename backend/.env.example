# chip-resonance .env.example
# =============================================================
# 複製此檔為 .env，填入實際值。.env 已被 gitignored，不會推到 GitHub。
# 所有可選憑證都可以留空 — pipeline 會自動 skip 沒有憑證的來源。
# =============================================================


# ========== 台股籌碼資料源（需登入）==========
#
# 重要：本專案**不支援帳密自動登入**。
# 神秘金字塔（MoneyDJ）/ Goodinfo / 集保（TDCC）需要登入時，
# 請手動登入一次，cookie 會存成 backend/.sessions/<site>.json：
#
#     python -m backend.scripts.auth_setup --site pyramid
#     python -m backend.scripts.auth_setup --site goodinfo
#     python -m backend.scripts.auth_setup --site tdcc
#     python -m backend.scripts.auth_setup --status   # 查看 session 狀態
#
# （2026-10 修正：舊版此處列有 PYRAMID_USERNAME / PYRAMID_PASSWORD /
#   GOODINFO_USERNAME / GOODINFO_PASSWORD，但程式從未讀取它們，
#   只會讓 meta.json 產生「已可登入」的假象。已移除。）

# 可選住宅代理：Goodinfo 對 datacenter IP 很嚴格，本機可能被擋
# 格式：http://user:pass@host:port 或 socks5://user:pass@host:port
GOODINFO_PROXY_URL=


# ========== 台股公開 API ==========

# FinMind（https://finmindtrade.com/）— 沒設仍可，用免費準 600/hr
# 申請：https://finmindtrade.com/finmind/register/
FINMIND_TOKEN=


# ========== 美股 / 全球股（未來擴充用）==========

# Finnhub — 美股即時報價、新聞、估值指標
# 申請：https://finnhub.io/register
FINNHUB_API_KEY=

# Alpha Vantage — 詳細基本面、年度財報
# 申請：https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Twelve Data — K 線、技術指標
# 申請：https://twelvedata.com/register
TWELVE_DATA_API_KEY=

# FRED — 10 年期美債殖利率（用於 WACC 計算）
# 申請：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC EDGAR（per fair access policy，必須填聯絡 email）
SEC_USER_AGENT=research@example.com


# ========== Pipeline 調校 ==========

# Rate limiter 抖動（秒），增加隨機性避免被偵測
RL_JITTER=0.5

# Pipeline 預設抓取名單大小（瀏覽器類來源抓幾檔個股）
# 設為 0 = 全部；設為 N = 前 N 檔（各來源預設不同：公開源 50 / 瀏覽器源 3~5）
# 這個值真的會生效（backend/pipeline.py: pipeline_limit / _select_codes）
PIPELINE_LIMIT=20

# session 檔案目錄（容器部署時可指向掛載點；預設 backend/.sessions）
# CHIP_RESONANCE_SESSION_DIR=/app/backend/.sessions
